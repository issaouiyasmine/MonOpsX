# ==================================================
# APPLICATION
# ==================================================

APP_NAME=MonOpsX
APP_VERSION=1.0.0
DEBUG=True

# ==================================================
# MONGODB
# ==================================================

MONGO_HOST=localhost
MONGO_PORT=27017

MONGO_USERNAME=admin
MONGO_PASSWORD=Password123!

MONGO_APP_DATABASE=monopsx_app

# ==================================================
# JWT
# ==================================================

JWT_SECRET_KEY=replace_with_32_characters_minimum_secret

JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================================================
# METRICS ALERT THRESHOLDS
# ==================================================

METRICS_CPU_ALERT_PERCENT=85
METRICS_MEMORY_ALERT_PERCENT=85
METRICS_DISK_ALERT_PERCENT=90

# ==================================================
# OLLAMA CHATBOT
# ==================================================

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
CHAT_METRICS_LIMIT=100
CHAT_HISTORY_LIMIT=30

# ==================================================
# PREDICTIONS
# ==================================================

PREDICTION_ENABLED=True
# mock permet de tester sans modele local. ollama utilise OLLAMA_BASE_URL.
# Si cette machine manque de RAM, gardez mock.
# Pour tester un vrai Llama, lancez Ollama sur une autre machine et utilisez:
# OLLAMA_BASE_URL=http://adresse-machine-distante:11434
# PREDICTION_MODE=ollama
PREDICTION_MODE=mock
PREDICTION_HORIZON_DAYS=3
PREDICTION_COOLDOWN_HOURS=24
PREDICTION_METRICS_LIMIT=24

# ==================================================
# ENCRYPTION
# ==================================================

ENCRYPTION_KEY=replace_with_generated_encryption_key
