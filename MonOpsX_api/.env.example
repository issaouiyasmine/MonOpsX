# ==================================================
# APPLICATION
# ==================================================

APP_NAME=MonOpsX
APP_VERSION=1.0.0
DEBUG=True

# ==================================================
# MONGODB
# ==================================================

MONGO_HOST=localhost
MONGO_PORT=27017

MONGO_USERNAME=admin
MONGO_PASSWORD=Password123!

MONGO_APP_DATABASE=monopsx_app

# ==================================================
# JWT
# ==================================================

JWT_SECRET_KEY=replace_with_32_characters_minimum_secret

JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================================================
# METRICS ALERT THRESHOLDS
# ==================================================

METRICS_CPU_ALERT_PERCENT=85
METRICS_MEMORY_ALERT_PERCENT=85
METRICS_DISK_ALERT_PERCENT=90

# ==================================================
# ENCRYPTION
# ==================================================

ENCRYPTION_KEY=replace_with_generated_encryption_key
