# Local development defaults to localhost in docker-compose.yml.
# Deployment: use public domains or server IPs in the app environment, not localhost.
# Example deployment values:
# EXPO_PUBLIC_API_URL=https://api.your-domain.com
# EXPO_PUBLIC_GRAFANA_BASE_URL=https://grafana.your-domain.com
# Physical phones on Wi-Fi cannot use localhost for the laptop; use a LAN IP or deployed URL.

# MongoDB root account used by the mongodb service.
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-me

# Ollama model pulled by the one-shot ollama-pull service.
OLLAMA_MODEL=llama3.2:3b
