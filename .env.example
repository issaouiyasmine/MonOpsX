# Le développement local utilise localhost dans docker-compose.yml.
# Déploiement: utilisez des domaines publics ou des IP serveur, pas localhost.
# Exemples de valeurs de déploiement:
# EXPO_PUBLIC_API_URL=https://api.votre-domaine.com
# EXPO_PUBLIC_GRAFANA_BASE_URL=https://grafana.votre-domaine.com
# EXPO_PUBLIC_GRAFANA_GLOBAL_DASHBOARDS=Vue globale|/d/monopsx-global/monopsx-global?orgId=1&var-account_id={accountId}
# EXPO_PUBLIC_GRAFANA_SERVER_DASHBOARDS=Metriques serveur|/d/monopsx-server/monopsx-server?orgId=1&var-account_id={accountId}&var-server_id={serverId}
# Téléphone physique sur Wi-Fi: localhost ne pointe pas vers le PC; utilisez une IP LAN ou une URL déployée.

# Compte root MongoDB utilisé par le service mongodb.
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-me

# Modèle Ollama téléchargé par le service ponctuel ollama-pull.
OLLAMA_MODEL=llama3.2:3b

# Predictions serveur: utilisez mock pour tester sans telecharger de modele local.
# Pour tester un vrai Llama sans RAM locale, lancez Ollama sur une autre machine
# puis configurez MonOpsX_api/.env avec OLLAMA_BASE_URL=http://adresse-machine:11434
# et PREDICTION_MODE=ollama.
PREDICTION_ENABLED=True
PREDICTION_MODE=mock
PREDICTION_HORIZON_DAYS=3
PREDICTION_COOLDOWN_HOURS=24
PREDICTION_METRICS_LIMIT=24

# Compte administrateur Grafana local.
# Déploiement: utilisez un mot de passe fort et exposez Grafana en HTTPS.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
