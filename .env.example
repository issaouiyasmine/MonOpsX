# Le développement local utilise localhost dans docker-compose.yml.
# Déploiement: utilisez des domaines publics ou des IP serveur, pas localhost.
# Exemples de valeurs de déploiement:
# EXPO_PUBLIC_API_URL=https://api.votre-domaine.com
# EXPO_PUBLIC_GRAFANA_BASE_URL=https://grafana.votre-domaine.com
# Téléphone physique sur Wi-Fi: localhost ne pointe pas vers le PC; utilisez une IP LAN ou une URL déployée.

# Compte root MongoDB utilisé par le service mongodb.
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-me

# Modèle Ollama téléchargé par le service ponctuel ollama-pull.
OLLAMA_MODEL=llama3.2:3b

# Compte administrateur Grafana local.
# Déploiement: utilisez un mot de passe fort et exposez Grafana en HTTPS.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
