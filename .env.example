# LAN address of the computer running Docker Compose.
# Required when opening Expo from a physical phone or tablet.
HOST_IP=192.168.1.100

# MongoDB root account used by the mongodb service.
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-me

# Ollama model pulled by the one-shot ollama-pull service.
OLLAMA_MODEL=llama3.2:3b
