# Developpement local web/emulateur.
# Deploiement: utilisez votre domaine API public, par exemple https://api.votre-domaine.com.
# Telephone physique sur Wi-Fi: localhost pointe vers le telephone; utilisez une IP LAN ou une URL deployee.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_MONOPSX_AGENT_DOWNLOAD_URL=https://github.com/votre-organisation/monopsx/releases/latest

# Integration des tableaux de bord Grafana OSS auto-heberges.
# Deploiement: utilisez votre domaine Grafana public, par exemple https://grafana.votre-domaine.com.
# Format: Titre|URL;Titre|URL. Les URL peuvent etre absolues ou relatives a EXPO_PUBLIC_GRAFANA_BASE_URL.
EXPO_PUBLIC_GRAFANA_BASE_URL=http://localhost:3000
EXPO_PUBLIC_GRAFANA_GLOBAL_DASHBOARDS=Vue globale|/d/monopsx-global/monopsx-global?orgId=1

# Les tableaux serveur acceptent les variables: {serverId}, {serverName}, {hostname}, {ip}.
EXPO_PUBLIC_GRAFANA_SERVER_DASHBOARDS=Metriques serveur|/d/monopsx-server/monopsx-server?orgId=1&var-server_id={serverId}
