# Développement local web/émulateur.
# Déploiement: utilisez votre domaine API public, par exemple https://api.votre-domaine.com.
# Téléphone physique sur Wi-Fi: localhost pointe vers le téléphone; utilisez une IP LAN ou une URL déployée.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Intégration des tableaux de bord Grafana OSS auto-hébergés.
# Déploiement: utilisez votre domaine Grafana public, par exemple https://grafana.votre-domaine.com.
# Format: Titre|URL;Titre|URL. Les URL peuvent être absolues ou relatives à EXPO_PUBLIC_GRAFANA_BASE_URL.
EXPO_PUBLIC_GRAFANA_BASE_URL=http://localhost:3000
EXPO_PUBLIC_GRAFANA_GLOBAL_DASHBOARDS=Vue globale|/d/<global-uid>/<global-slug>?orgId=1;Récapitulatif serveurs|/d/<global-uid>/<global-slug>?orgId=1

# Les tableaux serveur acceptent les variables: {serverId}, {serverName}, {hostname}, {ip}.
# L'exemple utilise des variables Grafana nommées server_id, hostname et ip.
EXPO_PUBLIC_GRAFANA_SERVER_DASHBOARDS=Métriques serveur|/d/<server-uid>/<server-slug>?orgId=1&var-server_id={serverId}&var-hostname={hostname}&var-ip={ip}
