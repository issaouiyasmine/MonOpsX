# Use the computer's LAN address when testing from a physical device.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000

# Self-hosted Grafana OSS dashboard embedding.
# Format: Title|URL;Title|URL. URLs can be absolute or relative to EXPO_PUBLIC_GRAFANA_BASE_URL.
EXPO_PUBLIC_GRAFANA_BASE_URL=http://192.168.1.100:3000
EXPO_PUBLIC_GRAFANA_GLOBAL_DASHBOARDS=Overview|/d/<global-uid>/<global-slug>?orgId=1;Servers recap|/d/<global-uid>/<global-slug>?orgId=1

# Server dashboards support placeholders: {serverId}, {serverName}, {hostname}, {ip}.
# Example uses Grafana dashboard variables named server_id, hostname, and ip.
EXPO_PUBLIC_GRAFANA_SERVER_DASHBOARDS=Server metrics|/d/<server-uid>/<server-slug>?orgId=1&var-server_id={serverId}&var-hostname={hostname}&var-ip={ip}
